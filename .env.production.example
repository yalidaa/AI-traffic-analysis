# MineShark Linux/Wazuh 虚拟机生产运行配置。
# 复制到部署主机的 .env，再填写真实凭据。
# 真实 API 密钥、密码、证书和主机专用凭据绝不能提交到仓库。

# Agent 报告生成使用的 DeepSeek 对话模型。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=8192

# FAISS RAG 使用的 DashScope 向量模型。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Linux 虚拟机中 Wazuh 一体化部署的默认配置。
WAZUH_BASE_URL=https://localhost:55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-*

# 配置可信 CA 证书后，生产环境应设为 true。
# 只有本地自签名实验虚拟机才使用 false。
WAZUH_VERIFY_SSL=false
WAZUH_TIMEOUT=20

# 传感器和 AI 告警路径；Console 进程必须具有读取权限。
MINESHARK_AI_ALERTS_PATH=/var/log/ai_alerts.json
WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
ZEEK_LOG_DIR=/opt/zeek/spool/zeek
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# RAG 文件配置。
MINESHARK_KNOWLEDGE_FILE=configs/reporting/security_playbook.jsonl
MINESHARK_RAG_INDEX_DIR=outputs/rag
