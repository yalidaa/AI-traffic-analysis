[Unit]
Description=MineShark offline Transformer sensor
After=mineshark-capture.service
Requires=mineshark-capture.service

[Service]
Type=simple
User=mineshark
Group=mineshark
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mineshark/venv/bin/mineshark-sensor --config /etc/mineshark/sensor.toml run
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/mineshark /opt/mineshark/models /var/spool/mineshark /opt/zeek/logs /var/log/suricata
ReadWritePaths=/var/lib/mineshark /var/log/mineshark

[Install]
WantedBy=multi-user.target
